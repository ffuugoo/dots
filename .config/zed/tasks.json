[
  {
    "label": "Copy agent config into new worktree",

    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",

    "cwd": "$ZED_WORKTREE_ROOT",

    "command": "cp",
    "args": [
      "-R",
      "$ZED_MAIN_GIT_WORKTREE/.claude",
      "$ZED_MAIN_GIT_WORKTREE/.codex",
      "$ZED_WORKTREE_ROOT/"
    ]
  }
]
